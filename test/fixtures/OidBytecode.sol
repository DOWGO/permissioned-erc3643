pragma solidity 0.8.26;

// Creation bytecode of @onchain-id/solidity 2.2.1, the published npm package the deployer deploys
// (solc 0.8.17, optimizer disabled). Third-party GPL-3.0 code, vendored as bytecode because those
// sources pin solc 0.8.17 and this project compiles with 0.8.26. Each function returns the
// artifact's `bytecode` field verbatim; the caller appends the constructor arguments.
//
//   identityCreation                 artifacts/contracts/Identity.sol/Identity.json
//   claimissuerCreation              artifacts/contracts/ClaimIssuer.sol/ClaimIssuer.json
//   identityProxyCreation            artifacts/contracts/proxy/IdentityProxy.sol/IdentityProxy.json
//   implementationAuthorityCreation  artifacts/contracts/proxy/ImplementationAuthority.sol/ImplementationAuthority.json
//
// Regenerate:
//   npm pack @onchain-id/solidity@2.2.1 && tar xzf onchain-id-solidity-2.2.1.tgz
//   jq -r .bytecode package/<artifact path above>
// then paste each result, without its 0x prefix, into the matching literal and run `forge fmt`.
library OidBytecode {
    function identityCreation() internal pure returns (bytes memory) {
        return hex"";
    }

    function claimissuerCreation() internal pure returns (bytes memory) {
        return hex"";
    }

    function identityProxyCreation() internal pure returns (bytes memory) {
        return hex"";
    }

    function implementationAuthorityCreation() internal pure returns (bytes memory) {
        return hex"";
    }
}
